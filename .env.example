# Copiar como .env para habilitar SQL Server. Sin configuración, SQL queda desactivado.
DB_ENABLED=false
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=TraficoIA
DB_USER=sa
DB_PASSWORD=alex
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no
# Usar DB_TRUST_SERVER_CERTIFICATE=yes SOLO en laboratorio con certificado autofirmado.
API_HOST=0.0.0.0
API_PORT=5000
